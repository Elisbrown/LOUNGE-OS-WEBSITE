# loungeos.app: one address per page, so Google does not see duplicates.
# Search Console listed https://www.loungeos.app/ and /index.html as
# copies of the home page; both now answer with a 301 to the real address.

<IfModule mod_rewrite.c>
RewriteEngine On

# One host: www.loungeos.app -> loungeos.app (301), path and query kept
RewriteCond %{HTTP_HOST} ^www\.loungeos\.app$ [NC]
RewriteRule ^(.*)$ https://loungeos.app/$1 [R=301,L]

# Folder addresses only: /index.html -> /, /fr/index.html -> /fr/ (301).
# THE_REQUEST is what the browser asked for, so the server's own internal
# lookup of index.html for "/" is not redirected again.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
</IfModule>
